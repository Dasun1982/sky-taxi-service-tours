VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# PHASE 3 — optional. Google Maps JavaScript API key (Places library
# enabled), restricted by HTTP referrer to this site's domain(s) in Google
# Cloud Console. This key is meant to be public-facing by Google's own
# design — restriction, not secrecy, is what protects it. Until it's set,
# the booking form's pickup/drop-off fields work exactly as plain text
# inputs, same as before Phase 3.
VITE_GOOGLE_MAPS_API_KEY=

# Fast-track build — optional. Base URL of the deployed
# sri-lanka-ai-tour-planner app, e.g. https://sky-planner.example.com — its
# public /booking/[id] page shows a customer their booking status. Until
# this is set, the booking form still shows the customer their booking
# reference (a plain code they can quote on WhatsApp), just without a
# clickable link.
VITE_BOOKING_STATUS_URL=
